{
  // Which files get linted lives here rather than in the invocation, so the
  // git hook, the bun script and CI cannot drift apart on scope.
  "globs": ["**/*.md"],
  // node_modules and tool caches are ignored by git already, so let git's list
  // be the single one rather than restating it here.
  "gitignore": true,
  "ignores": [
    // Generated by release-please; it belongs to the tool, not to us.
    "CHANGELOG.md"
  ],
  "config": {
    "default": true,

    // Line length is a judgement call, and proseWrap: "preserve" means
    // Prettier will not reflow to satisfy it.
    "MD013": false,
    // Inline HTML is occasionally the only way to say something in Markdown.
    "MD033": false,
    // The first line is not always a top-level heading.
    "MD041": false,

    // Below: rules with an opinion about layout Prettier has already decided.
    // Two tools arguing over the same character is a hook that fails twice and
    // fixes nothing, so the markdownlint side comes off.
    "MD004": false, // unordered list marker style
    "MD007": false, // unordered list indentation
    "MD012": false, // consecutive blank lines
    "MD049": false, // emphasis character style
    "MD050": false // strong-emphasis character style
  }
}
