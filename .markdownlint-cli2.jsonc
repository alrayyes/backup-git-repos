{
  // Which files get linted lives here rather than in the invocation, so the
  // git hook, the bun script and CI cannot drift apart on scope.
  "globs": ["**/*.md"],
  // node_modules and tool caches are ignored by git already, so let git's list
  // be the single one rather than restating it here.
  "gitignore": true,
  "ignores": [
    // Generated by release-please; it belongs to the tool, not to us.
    "CHANGELOG.md",
    // openspec's own change records: written by that tool as one long line
    // per paragraph, not hand-wrapped prose -- generated text belongs to
    // nobody (rules/markdown.md), not to this repo's line-length budget.
    "openspec/**"
  ],
  "config": {
    // The maintained bundle covering every rule with an opinion about
    // layout Prettier has already decided -- blank lines, fence style,
    // hard tabs, trailing spaces, list indent and marker spacing, and
    // (per its own default) line-length too. Hand-rolling this list
    // separately is how the style file and the linter reading it end up
    // disagreeing after either one updates (rules/markdown.md).
    "extends": "markdownlint/style/prettier",
    "default": true,

    // Re-enabled under its alias, not MD013 -- extends merges on the
    // literal key, so an MD013 block here would sit beside the inherited
    // `line-length: false` from the style above and lose silently. 100
    // covers every prose line in what ships (README/CONTRIBUTING/
    // INSTALL/SECURITY); a fenced code block or table cell needing more
    // room still isn't checked, since MD013's own defaults leave both off.
    "line-length": { "line_length": 100, "code_blocks": false, "tables": false },
    // Inline HTML is occasionally the only way to say something in Markdown.
    "MD033": false,
    // The first line is not always a top-level heading.
    "MD041": false,
    // Not part of the bundle above (that one only covers marker *spacing*,
    // MD030) -- Prettier does pick a bullet character, but not the one
    // this repo's existing prose already uses throughout.
    "MD004": false
  }
}
