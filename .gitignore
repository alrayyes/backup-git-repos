# Go build output
/backup-git-repos
/dist/

# `nix build`'s own output symlink.
/result

# Node.js / Bun
node_modules/

# Vale downloads its style packages rather than committing them. Named
# individually, never `styles/` wholesale -- that would ignore our own
# vocabulary along with them.
styles/Google/
styles/proselint/

# Local runs
/config.yaml
/backups/

# Claude Code's own working state -- worktrees, installed skills, session
# cache. Not repo content.
/.claude/
